---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  noindex?: boolean;
  ogImage?: string | null;
  wide?: boolean;
}

const {
  title,
  description = 'Deals and Finds — practical gift lists, cash-back picks, and affiliate deals with clear disclosures.',
  canonicalPath = Astro.url.pathname,
  type = 'website',
  publishedTime,
  noindex = false,
  ogImage = null,
  wide = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://spacexygrok.github.io');
const canonical = new URL(canonicalPath.replace(/\/?$/, '/') === '//' ? '/' : canonicalPath, site).href;
const fullTitle = title.includes('|') ? title : `${title} | Deals and Finds`;
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Deals and Finds" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:site" content="@DealsAndFindsHQ" />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <div class:list={['wrap', wide && 'wrap-wide']}>
      <header class="site">
        <nav aria-label="Primary">
          <a class="brand" href="/">Deals and Finds</a>
          <a href="/gifts/">Gift lists</a>
          <a href="/posts/holiday-gift-guide-2026/">Gift guide</a>
          <a href="https://linktr.ee/chadd990" rel="noopener">Shop</a>
          <a href="https://x.com/DealsAndFindsHQ" rel="noopener">X</a>
          <a href="/disclosure/">Disclosure</a>
          <a href="/privacy/">Privacy</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site">
        <p>
          <a href="https://x.com/DealsAndFindsHQ" rel="noopener">X @DealsAndFindsHQ</a>
          {' · '}
          <a href="https://linktr.ee/chadd990" rel="noopener">Linktree</a>
          {' · '}
          <a href="https://linktr.ee/chadd990?tab=shop" rel="noopener">Shop</a>
        </p>
        <p>
          Affiliate links use <code>rel="sponsored nofollow"</code>. See the
          <a href="/disclosure/">affiliate disclosure</a>. Not financial advice.
        </p>
        <p>&copy; {new Date().getFullYear()} Deals and Finds · Owned static site for SEO.</p>
      </footer>
    </div>
  </body>
</html>
